        <name>Populate Employee Details</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue == '') {
        return;
    }

    var ga = new GlideAjax('PopulateEmployeeDetails');
    ga.addParam('sysparm_name', 'getEmployeeDetails');
    ga.addParam('sysparm_user', newValue);

    ga.getXMLAnswer(function(response) {

        var data = JSON.parse(response);

        g_form.setValue('employee_name', data.name);
        g_form.setValue('employee_email', data.email);
        g_form.setValue('department', data.department);

    });
}]]></script>
